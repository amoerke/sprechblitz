# Transcription providers – at least one of them must be configured.
# Models in config/models.json whose provider is not configured are hidden from clients.

# OpenAI API key (never ships to clients). Also required for /v1/parse-* endpoints.
OPENAI_API_KEY=sk-...

# Self-hosted Whisper via speaches (OpenAI-compatible).
# docker-compose.yml starts speaches and defaults this to http://speaches:8000/v1;
# set it explicitly empty (SPEACHES_BASE_URL=) to hide the local models.
# Outside Compose (npm run dev) it is unset unless you set it here.
#SPEACHES_BASE_URL=http://speaches:8000/v1
# Only if speaches itself is protected with API_KEY (recommended when reachable via network/domain)
#SPEACHES_API_KEY=
# Compose only: speaches image (latest-cpu / latest-cuda).
# The server downloads all speaches models from config/models.json at startup.
#SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu

# Named client tokens, comma-separated "name:token".
# Each token must have at least 16 characters. Revoke a person by removing their entry.
# Generate a token e.g. with: openssl rand -hex 24
AUTH_TOKENS=andre:CHANGE_ME_MIN_16_CHARS

# Optional overrides
#PORT=8790
#HOST=0.0.0.0
#OPENAI_BASE_URL=https://api.openai.com/v1
#MODELS_CONFIG=config/models.json
#COMMANDS_CONFIG_DIR=config
#MAX_UPLOAD_BYTES=31457280
#PARSE_MODEL=gpt-4o-mini
#LOG_LEVEL=info
